# DingTalk Configuration (Stream Mode)
DINGTALK_APP_KEY=your_app_key_here
DINGTALK_APP_SECRET=your_app_secret_here

# Server Configuration
PORT=3000

# Work Directory (optional, default: current directory)
WORK_DIR=/path/to/your/project

# Access Control (optional, comma-separated user IDs)
# ALLOW_FROM=user1,user2

# Admin Control (optional, comma-separated user IDs)
# ADMIN_FROM=user1
